{
  "name": "infinite-canvas",
  "private": true,
  "version": "0.1.5",
  "description": "A Tauri, React, and TypeScript desktop application for an infinite canvas.",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "dev:daemon": "node scripts/devserver-daemon.mjs start",
    "dev:daemon:status": "node scripts/devserver-daemon.mjs status",
    "dev:daemon:stop": "node scripts/devserver-daemon.mjs stop",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "doctor": "react-doctor --yes --verbose",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked --lib",
    "check:frontend": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm run doctor && pnpm check:tokens && pnpm macos:signing-test && pnpm macos:install-test && pnpm update:manifest-test && pnpm test:coverage",
    "check:tokens": "node scripts/check-design-tokens.mjs --self-test",
    "audit:visuals": "node scripts/audit-visuals.mjs",
    "audit:icons": "node scripts/audit-icons.mjs",
    "check": "pnpm check:frontend && pnpm rust:fmt && pnpm rust:clippy && pnpm rust:test",
    "tauri": "tauri",
    "remotion:prepare": "node scripts/prepare-remotion-runtime.mjs",
    "ffmpeg:prepare": "node scripts/prepare-ffmpeg.mjs",
    "blender:prepare": "node scripts/prepare-blender-runtime.mjs",
    "pose:prepare": "node scripts/prepare-pose-runtime.mjs",
    "remotion:test": "node --test tools/remotion-runtime/plan.test.mjs",
    "blender:test": "node --test scripts/prepare-blender-runtime.test.mjs",
    "macos:signing-test": "node --test scripts/macos-signing-identity.test.mjs",
    "macos:install-test": "node --test scripts/install-macos.test.mjs",
    "macos:signing-identity": "node scripts/macos-signing-identity.mjs",
    "macos:verify-bundle": "bash scripts/verify-macos-bundle.sh",
    "update:manifest": "node scripts/write-latest-json.mjs",
    "update:publish": "node scripts/publish-tos-updates.mjs",
    "update:manifest-test": "node --test scripts/write-latest-json.test.mjs scripts/tauri-build.test.mjs scripts/tos-v4.test.mjs scripts/publish-tos-updates.test.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/tauri-build.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.102.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "^2",
    "@tauri-apps/plugin-upload": "^2.4.0",
    "@tauri-apps/plugin-websocket": "^2.4.2",
    "@tiptap/core": "^3.30.5",
    "@tiptap/extension-document": "^3.30.5",
    "@tiptap/extension-hard-break": "^3.30.5",
    "@tiptap/extension-paragraph": "^3.30.5",
    "@tiptap/extension-text": "^3.30.5",
    "@tiptap/extensions": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@xyflow/react": "12.11.5",
    "diff": "^9.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hotkeys-hook": "^5.3.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "three": "0.186.0",
    "valibot": "^1.4.2",
    "zundo": "^2.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react-doctor": "^0.9.14",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.1"
  }
}
