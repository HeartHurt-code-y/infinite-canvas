{
  "name": "infinite-canvas",
  "private": true,
  "version": "1.2.3",
  "description": "A Tauri, React, and TypeScript desktop application for an infinite canvas.",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "rea": "node scripts/rea.mjs",
    "dev": "node scripts/dev-server.mjs",
    "dev:daemon": "node scripts/devserver-daemon.mjs start",
    "dev:daemon:status": "node scripts/devserver-daemon.mjs status",
    "dev:daemon:stop": "node scripts/devserver-daemon.mjs stop",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "doctor": "react-doctor --yes --verbose",
    "knip": "knip",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "codegen": "cargo test --manifest-path src-tauri/Cargo.toml --locked --lib export_bindings",
    "codegen:check": "pnpm codegen && git diff --exit-code -- src/lib/bindings",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "check:frontend": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm run doctor && pnpm check:tokens",
    "check:tokens": "node scripts/check-design-tokens.mjs --self-test",
    "audit:visuals": "node scripts/audit-visuals.mjs",
    "audit:icons": "node scripts/audit-icons.mjs",
    "check": "pnpm check:frontend",
    "tauri": "tauri",
    "ffmpeg:prepare": "node scripts/prepare-ffmpeg.mjs",
    "macos:signing-identity": "node scripts/macos-signing-identity.mjs",
    "macos:verify-bundle": "bash scripts/verify-macos-bundle.sh",
    "update:manifest": "node scripts/write-latest-json.mjs",
    "update:publish": "node scripts/publish-tos-updates.mjs",
    "update:publish:online": "node scripts/publish-online-updates.mjs",
    "update:stage:macos": "node scripts/stage-macos-release.mjs",
    "update:baseline": "node scripts/runtime-resource-baseline.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/tauri-build.mjs",
    "tauri:build:online": "node scripts/tauri-build-edition.mjs online",
    "tauri:build:offline": "node scripts/tauri-build-edition.mjs offline"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.102.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@xyflow/react": "12.11.5",
    "diff": "^9.0.0",
    "lucide-react": "^1.60.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hotkeys-hook": "^5.3.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "three": "0.187.0",
    "valibot": "^1.4.2",
    "zundo": "^2.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "knip": "^6.41.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6",
    "react-doctor": "^0.9.14",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}
