{
  "$schema": "./node_modules/knip/schema.json",
  "entry": ["src/main.tsx", "scripts/*.mjs", "tools/**/*.mjs"],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "**/__fixtures__/**",
    "src/lib/bindings/**",
    "src/lib/brandModels.ts",
    "src/lib/brandDesignClient.ts"
  ],
  "rules": {
    "duplicates": "off",
    "exports": "warn",
    "nsExports": "off",
    "nsTypes": "off",
    "types": "off",
    "files": "error"
  }
}
