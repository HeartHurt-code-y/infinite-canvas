      "identifier": "fs:scope",
      "allow": ["**"]
    },
    {
      "identifier": "http:allow-fetch",
      "allow": ["http://*:*/*", "https://*:*/*"]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**",
          "app": true
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "*",
          "app": true
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "cmd": "cmd.exe",
          "args": true,
          "name": "cmd"
        },
        {
          "cmd": "powershell.exe",
          "args": true,
          "name": "powershell"
        },
        {
          "cmd": "pwsh",
          "args": true,
