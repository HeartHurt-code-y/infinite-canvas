{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "pnpm ffmpeg:prepare && pnpm build"
  },
  "bundle": {
    "resources": {
      "resources/ffmpeg/": "ffmpeg/"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://sd20-zq.tos-cn-beijing.volces.com/infinite-canvas/updates/{{target}}-{{arch}}-online/latest.json"
      ]
    }
  }
}
