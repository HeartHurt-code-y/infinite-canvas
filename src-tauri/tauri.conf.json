{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "无限画布",
  "version": "0.1.0",
  "identifier": "com.infinitecanvas.desktop",
  "build": {
    "beforeDevCommand": "pnpm ffmpeg:prepare && pnpm remotion:prepare && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm ffmpeg:prepare && pnpm remotion:prepare && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "无限画布",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "devtools": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "devCsp": null,
      "freezePrototype": false,
      "dangerousDisableAssetCspModification": true,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "infinitecanvas",
    "copyright": "Copyright © 2026 infinitecanvas",
    "resources": {
      "resources/remotion-runtime/": "remotion-runtime/",
      "resources/ffmpeg/": "ffmpeg/"
    },
    "windows": {
      "wix": {
        "language": "zh-CN",
        "upgradeCode": "9c60e3cb-cb4f-5d0f-b15c-8c2a7574b655"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
