{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "无限画布",
  "version": "0.1.3",
  "identifier": "com.infinitecanvas.desktop",
  "build": {
    "beforeDevCommand": "pnpm ffmpeg:prepare && pnpm remotion:prepare && pnpm blender:prepare && pnpm pose:prepare && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm ffmpeg:prepare && pnpm remotion:prepare && pnpm blender:prepare && pnpm pose:prepare && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "无限画布",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "devtools": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "devCsp": null,
      "freezePrototype": false,
      "dangerousDisableAssetCspModification": true,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "infinitecanvas",
    "copyright": "Copyright © 2026 infinitecanvas",
    "resources": {
      "resources/remotion-runtime/": "remotion-runtime/",
      "resources/ffmpeg/": "ffmpeg/",
      "resources/blender/": "blender/",
      "skills/anime-drama-v23/": "skills/anime-drama-v23/",
      "skills/music-video-workflow/": "skills/music-video-workflow/",
      "skills/gpt-image-2-style-library/LICENSE": "licenses/gpt-image-2-style-library-LICENSE",
      "skills/gpt-image-2-style-library/": "skills/gpt-image-2-style-library/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "zh-CN",
        "upgradeCode": "9c60e3cb-cb4f-5d0f-b15c-8c2a7574b655"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyODg5RDNFMDcwMURDClJXVGNBUWMrbllpQ0FQbmFRSVJCajdmdDd5eGpaYnFETzJ3Wlk3OXNMU0VMbVVkUTFhZ1BYTzNuCg==",
      "endpoints": [
        "https://sd20-zq.tos-cn-beijing.volces.com/infinite-canvas/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
